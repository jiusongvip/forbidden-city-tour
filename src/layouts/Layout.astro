--- 
import "../styles/global.css";
import { organizationSchema } from "../utils/schema";
const {
  title = "Forbidden City Tour",
  description = "Plan your Forbidden City tour in Beijing: guided tours, tickets, tips.",
  ogImage = "/images/og-default.webp",
  canonicalURL,
  schema,
  breadcrumbs,
} = Astro.props;
const siteURL = "https://www.forbidden-city-tour.com";
const rawPath = canonicalURL || Astro.url.pathname;
const pageURL = rawPath === "/"
  ? siteURL
  : `${siteURL}${rawPath.endsWith("/") ? rawPath : rawPath + "/"}`;
---
<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-05RV5GYHPR"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-05RV5GYHPR');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="canonical" href={pageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="preload" as="image" href="/images/hero.webp" fetchpriority="high" />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Forbidden City Tours" />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />
    <!-- Structured Data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema())} />
  </head>
  <body class="bg-stone text-ink antialiased">
    <nav class="sticky top-0 z-50 border-b border-stone-warm/80 bg-stone/90 backdrop-blur-sm">
      <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-6">
        <a href="/" class="flex items-center gap-2 font-display text-lg font-medium tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-sm bg-imperial text-sm font-bold text-white">FC</span>
          <span>Forbidden City Tours</span>
        </a>
        <div class="hidden items-center gap-8 text-sm font-medium text-charcoal md:flex">
          <a href="/#top-tours" class="transition-colors hover:text-imperial">Tours</a>
          <a href="/#categories" class="transition-colors hover:text-imperial">Private</a>
          <a href="/#tickets" class="transition-colors hover:text-imperial">Tickets</a>
          <a href="/#guide" class="transition-colors hover:text-imperial">Guide</a>
          <a href="/#faq" class="transition-colors hover:text-imperial">FAQ</a>
          <a href="/blog/" class="transition-colors hover:text-imperial">Blog</a>
        </div>
        <a href="/#top-tours" class="rounded-md bg-imperial px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-imperial-dark active:translate-y-px">
          Find a Tour
        </a>
      </div>
    </nav>
    {breadcrumbs && breadcrumbs.length > 1 && (
      <nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-6 pt-4">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs text-charcoal">
          {breadcrumbs.map((bc, i) => (
            <li class="flex items-center gap-1.5">
              {i < breadcrumbs.length - 1 ? (
                <a href={bc.url} class="hover:text-imperial transition-colors">{bc.name}</a>
              ) : (
                <span class="font-medium text-ink">{bc.name}</span>
              )}
              {i < breadcrumbs.length - 1 && <span aria-hidden="true" class="text-stone-warm">/</span>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <main>
      <slot />
    </main>
    <footer class="border-t border-stone-warm bg-ink">
      <div class="mx-auto max-w-7xl px-6 py-16">
      <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
        <div>
          <h3 class="mb-4 text-sm font-medium text-gold-light">Tours</h3>
            <ul class="space-y-2 text-sm text-stone-warm/60">
              <li><a href="/#top-tours" class="transition-colors hover:text-gold-light">All Tours</a></li>
              <li><a href="/tours/private-imperial-deep-dive/" class="transition-colors hover:text-gold-light">Private Tours</a></li>
              <li><a href="/tours/vip-skip-the-line/" class="transition-colors hover:text-gold-light">VIP Tours</a></li>
            </ul>
          </div>
        <div>
          <h3 class="mb-4 text-sm font-medium text-gold-light">Plan</h3>
            <ul class="space-y-2 text-sm text-stone-warm/60">
              <li><a href="/#tickets" class="transition-colors hover:text-gold-light">Tickets</a></li>
              <li><a href="/#guide" class="transition-colors hover:text-gold-light">Visitor Guide</a></li>
              <li><a href="/#plan" class="transition-colors hover:text-gold-light">How to Get There</a></li>
            </ul>
          </div>
        <div>
          <h3 class="mb-4 text-sm font-medium text-gold-light">Explore</h3>
            <ul class="space-y-2 text-sm text-stone-warm/60">
              <li><a href="/#why" class="transition-colors hover:text-gold-light">History</a></li>
              <li><a href="/#guide" class="transition-colors hover:text-gold-light">Photo Spots</a></li>
              <li><a href="/#nearby" class="transition-colors hover:text-gold-light">Nearby Attractions</a></li>
            </ul>
          </div>
        <div>
          <h3 class="mb-4 text-sm font-medium text-gold-light">Guides</h3>
            <ul class="space-y-2 text-sm text-stone-warm/60">
              <li><a href="/#faq" class="transition-colors hover:text-gold-light">FAQ</a></li>
              <li><a href="/blog/best-time-to-visit/" class="transition-colors hover:text-gold-light">Best Time to Visit</a></li>
              <li><a href="/blog/walking-tour/" class="transition-colors hover:text-gold-light">Walking Tour Tips</a></li>
              <li><a href="/blog/night-tour/" class="transition-colors hover:text-gold-light">Night Tour Guide</a></li>
            </ul>
          </div>
          <div>
            <h3 class="mb-4 text-sm font-medium text-gold-light">Company</h3>
            <ul class="space-y-2 text-sm text-stone-warm/60">
              <li><a href="/about/" class="transition-colors hover:text-gold-light">About Us</a></li>
              <li><a href="/contact/" class="transition-colors hover:text-gold-light">Contact</a></li>
              <li><a href="/privacy/" class="transition-colors hover:text-gold-light">Privacy Policy</a></li>
              <li><a href="/terms/" class="transition-colors hover:text-gold-light">Terms</a></li>
            </ul>
          </div>
        </div>
        <div class="mt-12 border-t border-stone-warm/10 pt-8 text-center text-xs text-stone-warm/60">
          Forbidden City Tours is an independent guide. Not affiliated with the Palace Museum.
        </div>
      </div>
    </footer>
  </body>
</html>