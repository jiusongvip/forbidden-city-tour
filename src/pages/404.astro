---
import Layout from "../layouts/Layout.astro";
---
<Layout
  title="Page Not Found — Forbidden City Tours"
  description="Page not found. Browse our Forbidden City tour guides, ticket info, and visitor tips for 2026."
  canonicalURL="/404"
>
  <section class="mx-auto flex min-h-[70dvh] max-w-3xl flex-col items-center justify-center px-6 text-center">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Page Not Found</h1>
    <p class="mt-4 max-w-md text-lg text-charcoal">
      The page you are looking for might have been moved or no longer exists. Let us help you find what you need.
    </p>
    <h2 class="mt-6 text-sm font-medium uppercase tracking-widest text-charcoal">What You Might Be Looking For</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <a href="/#top-tours" class="rounded-md bg-imperial px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-imperial-dark active:translate-y-px">
        Browse Tours
      </a>
      <a href="/#guide" class="rounded-md border border-imperial/20 px-6 py-3 text-sm font-medium text-imperial transition-colors hover:bg-imperial/5 active:translate-y-px">
        Visitor Guide
      </a>
    </div>
    <div class="mt-8 text-sm text-charcoal">
      <p>Or explore:</p>
      <div class="mt-3 flex flex-wrap justify-center gap-3">
        <a href="/#guide" class="underline underline-offset-2 hover:text-imperial">Tickets</a>
        <span class="text-stone-warm">·</span>
        <a href="/#faq" class="underline underline-offset-2 hover:text-imperial">FAQ</a>
        <span class="text-stone-warm">·</span>
        <a href="/#why" class="underline underline-offset-2 hover:text-imperial">History</a>
        <span class="text-stone-warm">·</span>
        <a href="/" class="underline underline-offset-2 hover:text-imperial">Home</a>
      </div>
    </div>
  </section>
</Layout>
