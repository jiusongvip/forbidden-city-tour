---
import Layout from "../../../layouts/Layout.astro";
import Icon from "../../../components/Icon.astro";
import { tours, type Tour } from "../../../data/tours";
import { breadcrumbListSchema, tourSchema } from "../../../utils/schema";

export function getStaticPaths() {
  return tours.map((t) => ({ params: { slug: t.slug } }));
}

const { slug } = Astro.params;
const tour = tours.find((t) => t.slug === slug) as Tour;
const related = tours.filter((t) => t.slug !== slug).slice(0, 3);
const schema = [tourSchema(tour), breadcrumbListSchema([{ name: "Home", url: "/" }, { name: "Tours", url: "/#top-tours" }, { name: tour.name, url: `/tours/${tour.slug}/` }])];
const topRated = tour.rating >= 4.8;
const verifiedReviews = tour.reviews.filter((r) => r.verified);
const formatDate = (d: string) => new Date(d + "T00:00:00").toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---
<Layout
  title={`${tour.name} | Forbidden City Tours 2026`}
  description={tour.description}
  canonicalURL={`/tours/${tour.slug}/`}
  schema={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Tours", url: "/#top-tours" }, { name: tour.name, url: `/tours/${tour.slug}/` }]}
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-16">
    <div class="grid gap-12 md:grid-cols-5">
      <div class="md:col-span-3">
        <img src={tour.image} alt={tour.name} class="w-full rounded-lg object-cover aspect-[16/9]" />
        <div class="mt-8 flex flex-wrap items-center gap-3">
          {topRated && (
            <span class="rounded-sm bg-gold px-2.5 py-1 text-xs font-bold uppercase tracking-widest text-ink">Top Rated</span>
          )}
          <span class="rounded-sm bg-imperial/10 px-3 py-1 text-xs font-medium uppercase tracking-widest text-imperial">{tour.category}</span>
          <span class="text-sm text-charcoal">{tour.duration}</span>
          <span class="inline-flex items-center gap-1.5 rounded-sm bg-gold/15 px-2.5 py-0.5 text-xs font-medium text-ink">
            {tour.rating} <span class="text-charcoal">({tour.reviewCount.toLocaleString()} reviews)</span>
          </span>
        </div>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-sm bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
            <Icon name="circleCheck" class="h-3.5 w-3.5" /> Recommended by {tour.recommendationRate}% of travellers
          </span>
          {tour.badgeOfExcellence && (
            <span class="inline-flex items-center gap-1.5 rounded-sm bg-gold/15 px-2.5 py-1 text-xs font-medium text-ink">
              <Icon name="star" class="h-3.5 w-3.5" /> Badge of Excellence
            </span>
          )}
          {tour.priceGuarantee && (
            <span class="inline-flex items-center gap-1.5 rounded-sm bg-imperial/10 px-2.5 py-1 text-xs font-medium text-imperial">
              Lowest Price Guarantee
            </span>
          )}
        </div>
        <h1 class="mt-4 text-4xl font-bold tracking-tight md:text-5xl">{tour.name}</h1>
        <p class="mt-4 text-lg text-charcoal">{tour.description}</p>
        <div class="mt-8 grid gap-px overflow-hidden rounded-lg border border-stone-warm bg-stone-warm sm:grid-cols-2 lg:grid-cols-4">
          <div class="bg-pearl p-4"><p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-charcoal"><Icon name="clock" class="h-3.5 w-3.5" /> Duration</p><p class="mt-1 font-display font-medium text-ink">{tour.duration}</p></div>
          <div class="bg-pearl p-4"><p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-charcoal"><Icon name="circleCheck" class="h-3.5 w-3.5" /> Cancellation</p><p class="mt-1 font-display font-medium text-emerald-700">{tour.freeCancellation ? "Free up to 24-48h" : "See policy"}</p></div>
          <div class="bg-pearl p-4"><p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-charcoal"><Icon name="circleCheck" class="h-3.5 w-3.5" /> Payment</p><p class="mt-1 font-display font-medium text-ink">{tour.payLater ? "Reserve now, pay later" : "Pay at booking"}</p></div>
          <div class="bg-pearl p-4"><p class="flex items-center gap-1.5 text-xs font-medium uppercase tracking-widest text-charcoal"><Icon name="users" class="h-3.5 w-3.5" /> Operator</p><p class="mt-1 font-display font-medium text-ink">{tour.operator}</p></div>
        </div>

        <div class="mt-10">
          <h2 class="text-2xl font-bold tracking-tight">Tour Highlights</h2>
          <ul class="mt-4 space-y-2">
            {tour.highlights.map((h) => (
              <li class="flex items-center gap-3 text-charcoal">
                <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-imperial/10 text-imperial"><Icon name="arrowRight" class="h-3 w-3" /></span>
                {h}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          <div class="rounded-lg border border-emerald-200 bg-emerald-50 p-6">
            <h3 class="font-display font-medium text-emerald-800">What's Included</h3>
            <ul class="mt-3 space-y-2 text-sm text-charcoal">
              {tour.includes.map((i) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 text-emerald-600"><Icon name="circleCheck" class="h-4 w-4" /></span>
                  {i}
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-lg border border-rose-200 bg-rose-50 p-6">
            <h3 class="font-display font-medium text-rose-800">Not Included</h3>
            <ul class="mt-3 space-y-2 text-sm text-charcoal">
              {tour.excludes.map((i) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 text-rose-500"><Icon name="circleXmark" class="h-4 w-4" /></span>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="mt-10">
          <h2 class="text-2xl font-bold tracking-tight">Meeting Point</h2>
          <p class="mt-3 text-charcoal">{tour.meetingPoint}</p>
        </div>

        {tour.notSuitable.length > 0 && (
          <div class="mt-10">
            <h2 class="text-2xl font-bold tracking-tight">Not Suitable For</h2>
            <ul class="mt-4 space-y-2">
              {tour.notSuitable.map((n) => (
                <li class="flex items-center gap-3 text-charcoal">
                  <span class="text-charcoal"><Icon name="circle" class="h-1.5 w-1.5" /></span>
                  {n}
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="mt-16">
          <h2 class="text-2xl font-bold tracking-tight">What Travelers Say</h2>
          <div class="mt-5 grid gap-6 rounded-lg border border-stone-warm bg-pearl p-6 sm:grid-cols-3">
            <div>
              <p class="font-display text-4xl font-bold text-ink">{tour.rating}</p>
              <p class="mt-1 text-sm text-charcoal">out of 5</p>
              <p class="mt-2 text-xs text-charcoal">{tour.reviewCount.toLocaleString()} verified reviews</p>
            </div>
            <div class="sm:col-span-2 space-y-3">
              <div class="flex items-center justify-between text-sm">
                <span class="text-charcoal">Guide</span>
                <span class="font-medium text-ink">{tour.ratingBreakdown.guide} / 5.0</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-stone-warm">
                <div class="h-1.5 rounded-full bg-gold" style={`width: ${(tour.ratingBreakdown.guide / 5) * 100}%`}></div>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-charcoal">Value for money</span>
                <span class="font-medium text-ink">{tour.ratingBreakdown.valueForMoney} / 5.0</span>
              </div>
              <div class="h-1.5 w-full rounded-full bg-stone-warm">
                <div class="h-1.5 rounded-full bg-gold" style={`width: ${(tour.ratingBreakdown.valueForMoney / 5) * 100}%`}></div>
              </div>
            </div>
          </div>
          <div class="mt-6 space-y-4">
            {verifiedReviews.map((r) => (
              <article class="rounded-lg border border-stone-warm bg-pearl p-6">
                <div class="flex flex-wrap items-center gap-3">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-imperial/10 font-display text-sm font-bold text-imperial">
                    {r.name.charAt(0)}
                  </span>
                  <div>
                    <p class="text-sm font-medium text-ink">{r.name}</p>
                    <p class="text-xs text-charcoal">{r.country} &middot; {formatDate(r.date)}</p>
                  </div>
                  <span class="ml-auto inline-flex items-center gap-1 rounded-sm bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                    <Icon name="circleCheck" class="h-3 w-3" /> Verified booking
                  </span>
                  <span class="rounded-sm bg-gold/15 px-2 py-0.5 text-xs font-medium text-ink">{r.rating} / 5</span>
                </div>
                <p class="mt-4 text-sm leading-relaxed text-charcoal">{r.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>

      <aside class="md:col-span-2">
        <div class="sticky top-24 space-y-4">
          <div class="rounded-lg border border-stone-warm bg-pearl p-6">
            <p class="text-sm text-charcoal">From</p>
            <p class="font-display text-3xl font-bold text-imperial">
              ${tour.priceFrom}
              {tour.wasFrom && <span class="ml-2 text-lg font-normal text-charcoal line-through">${tour.wasFrom}</span>}
            </p>
            <p class="text-sm text-charcoal">per person &middot; {tour.price}</p>
            {tour.freeCancellation && (
              <p class="mt-4 flex items-center gap-2 rounded-md bg-emerald-50 px-3 py-2 text-xs font-medium text-emerald-700">
                <Icon name="circleCheck" class="h-3.5 w-3.5" /> {tour.cancellationPolicy}
              </p>
            )}
            {tour.payLater && (
              <p class="mt-2 flex items-center gap-2 rounded-md bg-imperial/5 px-3 py-2 text-xs font-medium text-imperial">
                Reserve now &middot; pay later
              </p>
            )}
            <a
              href={tour.bookURL}
              target="_blank"
              rel="noopener sponsored"
              class="mt-5 block rounded-md bg-imperial px-6 py-3 text-center text-sm font-medium text-white transition-colors hover:bg-imperial-dark active:translate-y-px"
            >
              Book This Tour
            </a>
            <a href="/#top-tours" class="mt-3 block text-center text-sm font-medium text-imperial hover:underline">Compare all tours</a>
          </div>
          <div class="rounded-lg border border-stone-warm bg-pearl p-6 text-sm text-charcoal space-y-3">
            <div class="flex justify-between"><span>Duration</span><span class="font-medium text-ink">{tour.duration}</span></div>
            <div class="flex justify-between"><span>Category</span><span class="font-medium text-ink capitalize">{tour.category}</span></div>
            <div class="flex justify-between"><span>Rating</span><span class="font-medium text-ink">{tour.rating} / 5.0</span></div>
            <div class="border-t border-stone-warm pt-3">
              <p class="text-xs leading-relaxed">{tour.meetingPoint}</p>
            </div>
            <div class="border-t border-stone-warm pt-3 text-xs">
              <p>Supplied by <span class="font-medium text-ink">{tour.operator}</span></p>
              <p class="mt-0.5 text-charcoal">Product code: {tour.productCode}</p>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div class="mt-24">
      <h2 class="text-3xl font-bold tracking-tight">Other Tours You Might Like</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {related.map((r) => (
          <a href={`/tours/${r.slug}/`} class="group overflow-hidden rounded-lg border border-stone-warm bg-pearl transition-colors hover:border-imperial/20">
            <div class="h-44 overflow-hidden">
              <img src={r.image} alt={r.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
            </div>
            <div class="p-5">
              <div class="flex items-center justify-between">
                <span class="text-xs text-charcoal">{r.duration}</span>
                <span class="inline-flex items-center gap-1 rounded-sm bg-imperial/10 px-2 py-0.5 text-xs font-medium text-imperial">
                  {r.rating} <span class="text-charcoal">({r.reviewCount.toLocaleString()})</span>
                </span>
              </div>
              <h3 class="mt-2 font-display font-medium">{r.name}</h3>
              <p class="mt-2 font-medium text-imperial">
                From ${r.priceFrom}
                {r.wasFrom && <span class="ml-1.5 text-xs font-normal text-charcoal line-through">${r.wasFrom}</span>}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
