---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbListSchema, articleSchema } from "../../utils/schema";
const schema = [articleSchema("Forbidden City Tour Blog: Tips and Guides", "Travel tips, historical insights, and practical guides for visiting the Forbidden City.", "2026-07-30"), breadcrumbListSchema([{ name: "Home", url: "/" }, { name: "Blog", url: "/blog" }])];
---
<Layout
  title="Forbidden City Tour Blog | Tips, Guides & Stories"
  description="Forbidden City tour blog: travel tips, historical insights, photography guides, and practical advice for visiting Beijing's imperial palace in 2026."
  canonicalURL="/blog"
  schema={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Blog", url: "/blog" }]}
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Blog</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Tips, Guides & Stories</h1>
    <p class="mt-4 text-lg text-charcoal">Expert travel tips, historical deep-dives, and practical guides for your visit.</p>
  </section>
  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="divide-y divide-stone-warm border-t border-stone-warm">
      <a href="/blog/best-time-to-visit" class="block py-8 transition-opacity hover:opacity-65">
        <time datetime="2026-07-30" class="text-xs font-medium uppercase tracking-widest text-charcoal">July 30, 2026</time>
        <h2 class="mt-2 font-display text-xl font-medium">Best Time to Visit the Forbidden City: Month-by-Month Guide</h2>
        <p class="mt-2 text-charcoal">Compare weather, crowds, and ticket availability across all four seasons to find your ideal visit window.</p>
      </a>
      <a href="/blog/walking-tour" class="block py-8 transition-opacity hover:opacity-65">
        <time datetime="2026-07-30" class="text-xs font-medium uppercase tracking-widest text-charcoal">July 30, 2026</time>
        <h2 class="mt-2 font-display text-xl font-medium">Self-Guided Walking Tour: The Best DIY Route</h2>
        <p class="mt-2 text-charcoal">A complete step-by-step walking route covering every must-see hall, courtyard, and photo stop.</p>
      </a>
      <a href="/blog/night-tour" class="block py-8 transition-opacity hover:opacity-65">
        <time datetime="2026-07-30" class="text-xs font-medium uppercase tracking-widest text-charcoal">July 30, 2026</time>
        <h2 class="mt-2 font-display text-xl font-medium">Forbidden City Night Tour: Can You Visit After Dark?</h2>
        <p class="mt-2 text-charcoal">The truth about evening access and the best alternatives for seeing the palace illuminated at dusk.</p>
      </a>
    </div>
    <div class="mt-12 rounded-lg border border-stone-warm bg-pearl p-8 text-center">
      <h3 class="font-display text-lg font-medium">More articles coming soon</h3>
      <p class="mt-2 text-sm text-charcoal">Seasonal crowd tips, photography guides by season, and deep-dives into Forbidden City architecture.</p>
    </div>
  </section>
</Layout>
