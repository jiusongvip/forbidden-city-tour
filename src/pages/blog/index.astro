---
import Layout from "../../layouts/Layout.astro";
import { breadcrumbListSchema } from "../../utils/schema";

const posts = [
  {
    url: "/blog/best-time-to-visit/",
    tag: "Planning",
    title: "Best Time to Visit the Forbidden City: A Month-by-Month Guide",
    description: "Month-by-month weather, crowd levels, and photography conditions, plus the seasons and dates worth avoiding when you plan your 2026 visit.",
  },
  {
    url: "/blog/walking-tour/",
    tag: "Itineraries",
    title: "Self-Guided Forbidden City Walking Tour: The Best DIY Route",
    description: "Step-by-step DIY route covering the must-see halls, hidden courtyards, and the best photo stops — with timings for half-day and full-day visits.",
  },
  {
    url: "/blog/night-tour/",
    tag: "Tips",
    title: "Forbidden City Night Tour: Can You Visit After Dark?",
    description: "The truth about evening access to the palace, rare nighttime events, and the best alternatives for seeing the Forbidden City illuminated.",
  },
];

const schema = [breadcrumbListSchema([{ name: "Home", url: "/" }])];
---
<Layout
  title="Forbidden City Blog: Tips, Guides & Insider Advice 2026"
  description="Practical Forbidden City guides from our team: the best time to visit, self-guided walking routes, and the truth about night tours. Updated for 2026."
  canonicalURL="/blog/"
  schema={schema}
>
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-16">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Blog</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Forbidden City Travel Guides</h1>
    <p class="mt-4 text-lg text-charcoal">Practical, field-tested advice for visiting the Palace Museum: when to go, how to route your walk, and what to book in advance.</p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <h2 class="text-2xl font-bold tracking-tight">Latest Guides</h2>
    <div class="mt-8 space-y-6">
      {posts.map((post) => (
        <article class="rounded-lg border border-stone-warm bg-pearl p-6 transition-colors hover:border-imperial/30">
          <p class="text-xs font-medium uppercase tracking-widest text-imperial">{post.tag}</p>
          <h3 class="mt-2 font-display text-xl font-medium"><a href={post.url} class="hover:text-imperial transition-colors">{post.title}</a></h3>
          <p class="mt-2 text-sm leading-relaxed text-charcoal">{post.description}</p>
          <a href={post.url} class="mt-4 inline-block text-sm font-medium text-imperial underline underline-offset-2">Read the guide &rarr;</a>
        </article>
      ))}
    </div>

    <div class="mt-12 rounded-lg border border-stone-warm bg-pearl p-6">
      <h2 class="font-display text-xl font-medium">Planning a Guided Tour Instead?</h2>
      <p class="mt-3 text-sm leading-relaxed text-charcoal">Compare our expert-reviewed picks, from budget group tours to VIP skip-the-line experiences with ticket handling included.</p>
      <a href="/#top-tours" class="mt-4 inline-block rounded-md bg-imperial px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-imperial-dark active:translate-y-px">Browse All Tours</a>
    </div>
  </section>
</Layout>
