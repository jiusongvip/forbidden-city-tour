---
import Layout from "../layouts/Layout.astro";
import { tours } from "../data/tours";
import { breadcrumbListSchema, articleSchema } from "../utils/schema";
const privateTours = tours.filter((t) => t.category === "private");
const schema = [articleSchema("Private Forbidden City Tours: Custom Guides 2026", "Book a private Forbidden City tour with expert English-speaking guides. Tailored itineraries, skip-the-line access, in-depth history from $150.", "2026-07-30"), breadcrumbListSchema([{ name: "Home", url: "/" }, { name: "Private Tours", url: "/private-tours" }])];
---
<Layout
  title="Private Forbidden City Tours: Custom Guides 2026"
  description="Book a private Forbidden City tour with expert English-speaking guides. Tailored itineraries, skip-the-line entry, and in-depth history from $150."
  canonicalURL="/private-tours"
  schema={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Private Tours", url: "/private-tours" }]}
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-16">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Private Tours</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Private Forbidden City Tours: A Tailored Experience</h1>
    <p class="mt-4 max-w-xl text-lg text-charcoal">Book a private Forbidden City tour with expert guides. Tailored itineraries, skip-the-line access, in-depth history.</p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24">
    <div class="grid gap-8 md:grid-cols-2">
      {privateTours.map((tour) => (
        <a href={`/tours/${tour.slug}`} class="group overflow-hidden rounded-lg border border-stone-warm bg-pearl transition-colors hover:border-imperial/20">
          <div class="h-52 overflow-hidden">
            <img src={tour.image} alt={tour.name} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" />
          </div>
          <div class="p-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium uppercase tracking-widest text-gold">{tour.duration}</span>
              <span class="rounded-sm bg-imperial/10 px-2.5 py-0.5 text-xs font-medium text-imperial">{tour.rating}</span>
            </div>
            <h3 class="mt-3 font-display text-xl font-medium">{tour.name}</h3>
            <p class="mt-2 text-sm text-charcoal">{tour.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {tour.highlights.map((h) => (
                <span class="rounded-sm bg-stone-warm px-2.5 py-1 text-xs text-charcoal">{h}</span>
              ))}
            </div>
            <p class="mt-4 font-display text-lg font-medium text-imperial">{tour.price}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-24 grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">Private vs Group Tours</h2>
        <div class="mt-8 space-y-4">
          <div class="flex gap-4">
            <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-imperial/10 text-xs font-bold text-imperial">P</div>
            <div><strong class="text-sm">Your pace, your interests.</strong><p class="text-sm text-charcoal">Spend more time where you're curious, skip what doesn't interest you.</p></div>
          </div>
          <div class="flex gap-4">
            <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-imperial/10 text-xs font-bold text-imperial">P</div>
            <div><strong class="text-sm">Deeper historical context.</strong><p class="text-sm text-charcoal">Private guides are often historians or academics with specialized knowledge.</p></div>
          </div>
          <div class="flex gap-4">
            <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-sm bg-imperial/10 text-xs font-bold text-imperial">P</div>
            <div><strong class="text-sm">Skip-the-line where possible.</strong><p class="text-sm text-charcoal">Private tours often include priority entry and optimized routes.</p></div>
          </div>
        </div>
      </div>
      <div>
        <h2 class="text-3xl font-bold tracking-tight">Price Guide</h2>
        <p class="mt-4 text-charcoal">Private tours range from <strong class="text-ink">$150-$300</strong> per person depending on duration, guide expertise, and inclusions. Most include entry tickets and guide fees; some add lunch or tea ceremonies.</p>
        <p class="mt-4 text-sm text-charcoal">Booking at least 2-3 weeks in advance is recommended for the best guide availability, especially during peak seasons (spring and autumn).</p>
      </div>
    </div>
  </section>
</Layout>
