---
import Layout from "../layouts/Layout.astro";
import { breadcrumbListSchema, howToSchema } from "../utils/schema";
const steps = [
  { name: "Visit the official Palace Museum website", text: "Go to dpm.org.cn or use the WeChat mini-program 'Palace Museum'. This is the only official channel." },
  { name: "Select your date and time slot", text: "Tickets are released 7 days in advance at 8:00 PM Beijing time. Morning (8:30-12:00) and afternoon (12:00-close) slots available." },
  { name: "Enter passport details", text: "Each visitor needs to provide their full name and passport number. Foreign visitors must use their passport." },
  { name: "Pay and receive confirmation", text: "Pay via WeChat Pay or Alipay. You will receive a QR code, bring this and your passport on the day." },
];
const schema = [howToSchema("How to Buy Forbidden City Tickets", steps), breadcrumbListSchema([{ name: "Home", url: "/" }, { name: "Tickets", url: "/tickets" }])];
---
<Layout
  title="Forbidden City Tickets 2026 | Prices & Booking Guide"
  description="Forbidden City tickets 2026: prices (60 CNY peak, 40 CNY off-peak), how to book online 7 days ahead, passport rules, and tips to avoid sold-out dates."
  canonicalURL="/tickets"
  schema={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Tickets", url: "/tickets" }]}
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-16">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Tickets</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">How to Buy Forbidden City Tickets: Complete Guide for 2026</h1>
    <p class="mt-4 max-w-xl text-lg text-charcoal">Everything you need to know about prices, booking online, avoiding sold-out dates, and passport requirements.</p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24">
    <div class="grid gap-16 md:grid-cols-5">
      <div class="md:col-span-3 space-y-16">
        <div>
          <h2 class="text-3xl font-bold tracking-tight">Ticket Prices</h2>
          <div class="mt-6 overflow-hidden rounded-lg border border-stone-warm">
            <table class="w-full text-sm">
              <thead class="border-b border-stone-warm bg-stone-warm/50">
                <tr><th class="px-5 py-3 text-left font-medium">Season</th><th class="px-5 py-3 text-left font-medium">Dates</th><th class="px-5 py-3 text-right font-medium">Price</th></tr>
              </thead>
              <tbody class="divide-y divide-stone-warm">
                <tr><td class="px-5 py-3">Peak</td><td class="px-5 py-3 text-charcoal">April 1 - October 31</td><td class="px-5 py-3 text-right font-medium">60 CNY</td></tr>
                <tr><td class="px-5 py-3">Off-peak</td><td class="px-5 py-3 text-charcoal">November 1 - March 31</td><td class="px-5 py-3 text-right font-medium">40 CNY</td></tr>
                <tr><td class="px-5 py-3">Treasure Gallery</td><td class="px-5 py-3 text-charcoal">Additional ticket</td><td class="px-5 py-3 text-right font-medium">10 CNY</td></tr>
                <tr><td class="px-5 py-3">Clock Exhibition</td><td class="px-5 py-3 text-charcoal">Additional ticket</td><td class="px-5 py-3 text-right font-medium">10 CNY</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <div>
          <h2 class="text-3xl font-bold tracking-tight">How to Book</h2>
          <ol class="mt-6 space-y-6">
            <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-sm bg-imperial text-sm font-bold text-white">1</span><div><strong class="font-medium">Visit the official Palace Museum website</strong><p class="mt-1 text-sm text-charcoal">Go to dpm.org.cn or use the WeChat mini-program "Palace Museum". This is the only official channel.</p></div></li>
            <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-sm bg-imperial text-sm font-bold text-white">2</span><div><strong class="font-medium">Select your date and time slot</strong><p class="mt-1 text-sm text-charcoal">Tickets are released 7 days in advance at 8:00 PM Beijing time. Morning (8:30-12:00) and afternoon (12:00-close) slots available.</p></div></li>
            <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-sm bg-imperial text-sm font-bold text-white">3</span><div><strong class="font-medium">Enter passport details</strong><p class="mt-1 text-sm text-charcoal">Each visitor needs to provide their full name and passport number. Foreign visitors must use their passport, not a local ID.</p></div></li>
            <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-sm bg-imperial text-sm font-bold text-white">4</span><div><strong class="font-medium">Pay and receive confirmation</strong><p class="mt-1 text-sm text-charcoal">Pay via WeChat Pay or Alipay. You will receive a QR code, bring this and your passport on the day.</p></div></li>
          </ol>
        </div>
      </div>
      <aside class="md:col-span-2 space-y-8">
        <div class="rounded-lg border border-imperial/15 bg-imperial/5 p-6"><h3 class="font-display font-medium text-imperial">Important Notice</h3><ul class="mt-3 space-y-2 text-sm text-charcoal"><li>Tickets sell out fast. Be ready at 8:00 PM Beijing time exactly 7 days before.</li><li>You must bring the same passport used for booking. No exceptions.</li><li>Entry is through the Meridian Gate (south gate) only.</li><li>Daily visitor limit: 80,000.</li></ul></div>
        <div class="rounded-lg border border-stone-warm bg-pearl p-6"><h3 class="font-display font-medium">Third-Party Platforms</h3><p class="mt-2 text-sm text-charcoal">Trip.com, Klook, and others resell tickets at a 20-50% markup.</p></div>
        <div class="rounded-lg border border-stone-warm bg-pearl p-6"><h3 class="font-display font-medium">Tour Packages Include Tickets</h3><p class="mt-2 text-sm text-charcoal">Booking a guided tour often includes ticket handling. Easiest option for international visitors.</p><a href="/tours" class="mt-3 inline-block text-sm font-medium text-imperial hover:underline">Browse tours with tickets included</a></div>
      </aside>
    </div>
  </section>
</Layout>
