---
import Layout from "../layouts/Layout.astro";
import { breadcrumbListSchema, articleSchema } from "../utils/schema";
const schema = [articleSchema("6 Best Attractions Near the Forbidden City 2026", "Discover the 6 best attractions near the Forbidden City: Tiananmen Square, Jingshan Park, Beihai Park, Wangfujing, National Museum, and Qianmen.", "2026-07-30"), breadcrumbListSchema([{ name: "Home", url: "/" }, { name: "Nearby Attractions", url: "/nearby" }])];
---
<Layout
  title="6 Best Attractions Near the Forbidden City 2026"
  description="6 best attractions near the Forbidden City: Tiananmen Square, Jingshan Park, Beihai Park, Wangfujing, National Museum of China, and Qianmen Street."
  canonicalURL="/nearby"
  schema={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Nearby", url: "/nearby" }]}
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-16">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Nearby</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Attractions Near the Forbidden City</h1>
    <p class="mt-4 max-w-xl text-lg text-charcoal">Six must-see places within a 15-minute walk of the palace. Perfect for combining with your visit.</p>
  </section>
  <section class="mx-auto max-w-3xl px-6 pb-24">
    <h2 class="text-2xl font-bold tracking-tight mb-8">6 Attractions Within Walking Distance</h2>
    <div class="space-y-10">
      <div class="flex gap-4"><span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">1</span><div><strong class="font-medium">Tiananmen Square</strong><p class="text-sm text-charcoal">Directly south of the Forbidden City. The world’s largest public square (440,000 sqm), flanked by the Great Hall of the People, Mao’s Mausoleum, and the Monument to the People’s Heroes. Free entry. Security check required. You will pass through here on your way to the Meridian Gate.</p></div></div>
      <div class="flex gap-4"><span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">2</span><div><strong class="font-medium">Jingshan Park</strong><p class="text-sm text-charcoal">Directly north, across the street from the exit. <strong>This is the single best panoramic view of the Forbidden City.</strong> Climb to the hilltop pagoda (10 minutes uphill) for the iconic rooftop photo. Entry: 2 CNY. Open 6:00 AM-9:00 PM (summer), 6:30 AM-8:00 PM (winter). Don’t skip this — it is worth every step.</p></div></div>
      <div class="flex gap-4"><span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">3</span><div><strong class="font-medium">Beihai Park</strong><p class="text-sm text-charcoal">One of China’s oldest imperial gardens, west of the Forbidden City. Famous for the White Dagoba on Jade Flower Island and the Nine-Dragon Screen. Beautiful in spring when cherry blossoms bloom around the lake. Entry: 10 CNY (peak), 5 CNY (off-peak). 15-minute walk from the north gate.</p></div></div>
      <div class="flex gap-4"><span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">4</span><div><strong class="font-medium">Wangfujing Shopping Street</strong><p class="text-sm text-charcoal">Beijing’s most famous shopping street, east of the Forbidden City. Great for post-tour dining and exploring. Try the Wangfujing Snack Street for adventurous eats (scorpion skewers, anyone?) or stick to the modern malls for familiar brands. 15-minute walk from the east gate.</p></div></div>
      <div class="flex gap-4"><span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">5</span><div><strong class="font-medium">National Museum of China</strong><p class="text-sm text-charcoal">On the east side of Tiananmen Square. Houses over 1.4 million artifacts spanning 5,000 years of Chinese civilization. Highlights include the Simuwu Ding (the world’s heaviest ancient bronze) and the Jade Burial Suit. Free entry with passport. Closed Mondays.</p></div></div>
      <div class="flex gap-4"><span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">6</span><div><strong class="font-medium">Qianmen Street</strong><p class="text-sm text-charcoal">A historic commercial street south of Tiananmen Square. Restored Qing Dynasty-era storefronts, traditional tea houses, and the best Peking duck restaurants in Beijing. Perfect for an evening stroll after a day at the Forbidden City. 15-20 minutes south of the square.</p></div></div>
    </div>
  
  </section>

</Layout>
