---
import Layout from "../layouts/Layout.astro";
import { breadcrumbListSchema, articleSchema } from "../utils/schema";
const schema = [articleSchema("How to Visit the Forbidden City: The Complete 2026 Guide", "Everything you need to know before visiting Beijing's imperial palace: best routes, what to see, how to plan your day, and essential tips.", "2026-07-30"), breadcrumbListSchema([{ name: "Home", url: "/" }, { name: "Guide", url: "/guide" }])];
---
<Layout
  title="Forbidden City Travel Guide 2026: How to Visit & What to See"
  description="Complete Forbidden City guide 2026: best route (4-5 hrs), what to see, and how to plan your day at Beijing's imperial palace. Insider tips inside."
  canonicalURL="/guide"
  schema={schema}
  breadcrumbs={[{ name: "Home", url: "/" }, { name: "Guide", url: "/guide" }]}
>
  <section class="mx-auto max-w-7xl px-6 pt-24 pb-16">
    <p class="text-sm font-medium uppercase tracking-widest text-imperial">Guide</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">How to Visit the Forbidden City: The Complete Guide</h1>
    <p class="mt-4 max-w-xl text-lg text-charcoal">Everything you need to know before visiting Beijing's imperial palace: best routes, what to see, and how to plan your day.</p>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-24">
    <div class="grid gap-16 md:grid-cols-5">
      <article class="md:col-span-3 space-y-16">
        <div>
          <h2 class="text-2xl font-bold tracking-tight">Best Time to Visit</h2>
          <p class="mt-4 text-charcoal">Spring (April-May) and autumn (September-October) offer the best weather, mild temperatures and blue skies perfect for photography. Arrive at the Meridian Gate by <strong>8:00 AM</strong> to beat the crowd. The palace opens at 8:30 AM.</p>
          <p class="mt-3 text-charcoal">Avoid Chinese national holidays (Golden Week in early October, Chinese New Year) when the city is packed with domestic tourists.</p>
        </div>

        <div>
          <h2 class="text-2xl font-bold tracking-tight">Suggested Route (4-5 hours)</h2>
          <ol class="mt-6 space-y-4">
            <li class="flex gap-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">1</span>
              <div><strong class="font-medium">Meridian Gate</strong> <span class="text-charcoal">- Enter through the south gate. This massive gate alone is worth 15 minutes of admiring.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">2</span>
              <div><strong class="font-medium">Hall of Supreme Harmony</strong> <span class="text-charcoal">- The iconic throne hall. Peak into the interior from the viewing area. Crowded, so be patient for a front-row view.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">3</span>
              <div><strong class="font-medium">Hall of Central Harmony & Hall of Preserving Harmony</strong> <span class="text-charcoal">- Behind Supreme Harmony. Less crowded, more detailed views of imperial architecture.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">4</span>
              <div><strong class="font-medium">Palace of Heavenly Purity</strong> <span class="text-charcoal">- The emperor's living quarters. A quieter section with intimate scale and fascinating details.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">5</span>
              <div><strong class="font-medium">Treasure Gallery</strong> <span class="text-charcoal">- Worth the 10 CNY extra. Imperial jewelry, jade, and ceremonial objects in a series of connected halls.</span></div>
            </li>
            <li class="flex gap-4">
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-sm bg-imperial text-xs font-bold text-white">6</span>
              <div><strong class="font-medium">Imperial Garden</strong> <span class="text-charcoal">- End your visit at the tranquil garden before exiting north. Ancient cypress trees, rockeries, and pavilions.</span></div>
            </li>
          </ol>
        </div>

        <div>
          <h2 class="text-2xl font-bold tracking-tight">What to Bring</h2>
          <ul class="mt-4 space-y-2 text-charcoal">
            <li><strong>Passport</strong> — Required for entry. The name must match your ticket.</li>
            <li><strong>Comfortable shoes</strong> — You will walk 5-8 km on stone and marble. No exaggeration.</li>
            <li><strong>Water and snacks</strong> — There are cafes inside but they're expensive and busy. Bring your own.</li>
            <li><strong>Sunscreen and hat</strong> — There is very little shade in the courtyards.</li>
            <li><strong>Power bank</strong> — You will take hundreds of photos.</li>
          </ul>
        </div>
      </article>

      <aside class="md:col-span-2 space-y-8">
        <div class="rounded-lg border border-imperial/15 bg-imperial/5 p-6">
          <h3 class="font-display font-medium text-imperial">Quick Facts</h3>
          <div class="mt-3 space-y-2 text-sm">
            <div class="flex justify-between"><span class="text-charcoal">Size</span><span class="font-medium">72 hectares</span></div>
            <div class="flex justify-between"><span class="text-charcoal">Buildings</span><span class="font-medium">980</span></div>
            <div class="flex justify-between"><span class="text-charcoal">Rooms</span><span class="font-medium">8,704</span></div>
            <div class="flex justify-between"><span class="text-charcoal">Built</span><span class="font-medium">1406-1420</span></div>
            <div class="flex justify-between"><span class="text-charcoal">Visitors/year</span><span class="font-medium">16 million</span></div>
            <div class="flex justify-between"><span class="text-charcoal">UNESCO</span><span class="font-medium">Since 1987</span></div>
          </div>
        </div>
        <div class="rounded-lg border border-stone-warm bg-pearl p-6">
          <h3 class="font-display font-medium">Related Pages</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/tickets" class="text-imperial hover:underline">Ticket Buying Guide</a></li>
            <li><a href="/transport" class="text-imperial hover:underline">How to Get There</a></li>
            <li><a href="/photo-spots" class="text-imperial hover:underline">Best Photo Spots</a></li>
            <li><a href="/history" class="text-imperial hover:underline">Forbidden City History</a></li>
            <li><a href="/nearby" class="text-imperial hover:underline">Nearby Attractions</a></li>
          </ul>
        </div>
      </aside>
    </div>
  
  </section>

</Layout>
